      "cell_type": "code",
      "source": [
        "from pypdf import PdfReader\n",
        "from langchain_core.documents import Document\n",
        "\n",
        "pdf_path = \"Nestle_HR_Chatbot_Sample_Report.pdf\"\n",
        "\n",
        "reader = PdfReader(pdf_path)\n",
        "\n",
        "topics = [\n",
        "    \"Report scope and chatbot instructions\",\n",
        "    \"Workforce and recruitment\",\n",
        "    \"Leave and flexible work policies\",\n",
        "    \"Benefits, learning, and performance\",\n",
        "    \"HR service requests and retrieval checks\",\n",
        "]\n",
        "\n",
        "chunks = []\n",
        "\n",
        "for page_number, page in enumerate(reader.pages, start=1):\n",
        "    text = page.extract_text() or \"\"\n",
        "\n",
        "    if not text.strip():\n",
        "        continue\n",
        "\n",
        "    chunk = Document(\n",
        "        page_content=text,\n",
        "        metadata={\n",
        "            \"source\": pdf_path,\n",
        "            \"page\": page_number,\n",
        "            \"topic\": topics[page_number - 1],\n",
        "            \"fictional\": True,\n",
        "        },\n",
        "    )\n",
        "\n",
        "    chunks.append(chunk)\n",
        "\n",
        "print(\"Total chunks:\", len(chunks))\n",
        "\n",
        "for chunk in chunks:\n",
        "    print(\n",
        "        f\"Page {chunk.metadata['page']} | \"\n",
        "        f\"{chunk.metadata['topic']} | \"\n",
        "        f\"{len(chunk.page_content)} characters\"\n",
        "    )\n"
      ],
